# Smart Grievance System - Environment Configuration
# Copy this file to .env for local usage.
# For production, set equivalent values in your host dashboard (Render, etc.).

# ============================================================
# REQUIRED IN PRODUCTION
# ============================================================
FLASK_ENV=development
SECRET_KEY=replace-with-strong-random-secret
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///grievance.db

# ============================================================
# EMAIL DELIVERY (SMTP)
# ============================================================
# Keep false in production. Set true only for local debugging.
DEMO_EMAIL_MODE=false
# SMTP settings (required only when DEMO_EMAIL_MODE=false)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Smart Grievance System <noreply@grievance.gov>

# ============================================================
# EMAIL DELIVERY (FORMSPREE FALLBACK)
# ============================================================
# Optional: Use Formspree if SMTP is unavailable in your environment.
FORMSPREE_ENDPOINT=

# ============================================================
# AUTH TOKEN SETTINGS
# ============================================================
JWT_RESET_TOKEN_EXPIRES_MINUTES=15
ENABLE_REFRESH_TOKENS=true
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ============================================================
# APP + BACKGROUND WORKERS
# ============================================================
PORT=8000
AUTO_CREATE_TABLES=false
ENABLE_STARTUP_MODEL_LOAD=true
ENABLE_SCHEDULER=true
# NOTE: Set SCHEDULER_AUTOSTART=true on EXACTLY ONE production instance.
SCHEDULER_AUTOSTART=false
ENABLE_SCHEDULED_RETRAIN=true
RETRAIN_INTERVAL_HOURS=168

# ============================================================
# ML & MODERATION SETTINGS
# ============================================================
ML_AUTO_ASSIGN_CONFIDENCE_THRESHOLD=0.65
ML_MANUAL_REVIEW_DEPARTMENT=Manual Review Queue

# ============================================================
# RAG CHATBOT (AI Grievance Assistant)
# ============================================================
# Required: Your Google Gemini API key for the RAG chatbot.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional overrides (defaults shown):
# RAG_EMBEDDING_MODEL=gemini-embedding-001
# RAG_GENERATION_MODEL=gemini-2.5-flash
# RAG_DOCUMENTS_DIR=DOCSforRAG
# RAG_INDEX_PATH=rag_index.sqlite3
# RAG_TOP_K=5
# RAG_MIN_SIMILARITY=0.35

# ============================================================
# LOCAL/PROD PROFILE REFERENCE
# ============================================================
# Local dev:
#   FLASK_ENV=development
#   DATABASE_URL=sqlite:///grievance.db
#   APP_BASE_URL=http://localhost:8000
#   DEMO_EMAIL_MODE=true
#
# Production deployment:
#   FLASK_ENV=production
#   DATABASE_URL=<postgresql://...>
#   SECRET_KEY=<strong random secret>
#   DEMO_EMAIL_MODE=false
#   MAIL_USERNAME=<smtp user>
#   MAIL_PASSWORD=<smtp password>
#   APP_BASE_URL=https://<your-domain>
